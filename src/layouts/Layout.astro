---
import '../styles/global.css';
import { CALENDLY_URL, CTA_LABEL } from '../data/site';

export interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const SITE = 'https://redghostops.com';

const {
  title = 'REDOPS Security — Offensive Security Consultancy',
  description = 'Penetration testing and adversary simulation by a senior operator. Fixed scope, published prices, reports your engineers can act on. EU-registered.',
  path = '/',
} = Astro.props;

const canonical = new URL(path, SITE).href;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/about/', label: 'About' },
  { href: 'https://blog.redghostops.com', label: 'Research', external: true },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <link rel="icon" type="image/png" href="/logo.png" />
  <link rel="preload" href="/fonts/newsreader-var.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/jetbrains-mono-400.woff2" as="font" type="font/woff2" crossorigin />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="REDOPS Security" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${SITE}/logo.png`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${SITE}/logo.png`} />
</head>

<body class="min-h-screen bg-paper text-ink">
  <a href="#main" class="skip-link">Skip to content</a>

  <nav class="sticky top-0 z-50 border-b border-rule bg-paper/95 backdrop-blur-sm">
    <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center gap-4 md:gap-6">
      <a href="/" class="flex items-center gap-3 shrink-0">
        <img src="/logo.png" alt="" width="32" height="32" class="w-8 h-8" />
        <span class="text-step--1 md:text-step-0 font-semibold tracking-tight whitespace-nowrap">REDOPS Security</span>
      </a>

      <div class="hidden md:flex items-center gap-7 text-step--1">
        {nav.map((item) => (
          <a
            href={item.href}
            class="text-muted hover:text-ink transition-colors"
            {...(item.external ? { rel: 'noopener', target: '_blank' } : {})}
          >{item.label}</a>
        ))}
        <a href={CALENDLY_URL} target="_blank" rel="noopener" class="btn-primary !px-4 !py-2 text-step--1">
          {CTA_LABEL}
        </a>
      </div>

      <div class="md:hidden flex items-center gap-2">
        <a href={CALENDLY_URL} target="_blank" rel="noopener" class="btn-primary !px-3 !py-1.5 text-step--1 whitespace-nowrap">
          Book a call
        </a>
      <button
        id="menu-btn"
        class="p-2 -mr-2 text-ink"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <line x1="3" y1="7" x2="21" y2="7"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="17" x2="21" y2="17"></line>
        </svg>
      </button>
      </div>
    </div>

    <div id="mobile-menu" class="md:hidden hidden border-t border-rule">
      <div class="px-6 py-5 flex flex-col gap-4 text-step-0">
        {nav.map((item) => (
          <a
            href={item.href}
            class="text-muted hover:text-ink transition-colors"
            {...(item.external ? { rel: 'noopener', target: '_blank' } : {})}
          >{item.label}</a>
        ))}
        <a href={CALENDLY_URL} target="_blank" rel="noopener" class="btn-primary">
          {CTA_LABEL}
        </a>
      </div>
    </div>
  </nav>

  <main id="main">
    <slot />
  </main>

  <footer class="border-t border-rule mt-28">
    <div class="max-w-6xl mx-auto px-6 py-14">
      <div class="grid md:grid-cols-3 gap-10 mb-10">
        <div>
          <div class="font-semibold mb-3">REDOPS Security</div>
          <p class="text-muted text-step--1 max-w-prose">
            Penetration testing and adversary simulation, delivered by the person who does the testing.
          </p>
          <p class="machine text-step--1 text-muted mt-4">REDOPS Security Ltd. · Cyprus · HE 491541</p>
        </div>

        <div>
          <div class="text-step--1 text-muted mb-3">Site</div>
          <ul class="space-y-2 text-step--1">
            <li><a href="/services/" class="hover:text-critical-text transition-colors">Services and pricing</a></li>
            <li><a href="/about/" class="hover:text-critical-text transition-colors">About</a></li>
            <li><a href="https://blog.redghostops.com" rel="noopener" target="_blank" class="hover:text-critical-text transition-colors">Research</a></li>
            <li><a href="/contact/" class="hover:text-critical-text transition-colors">Contact</a></li>
          </ul>
        </div>

        <div>
          <div class="text-step--1 text-muted mb-3">Contact</div>
          <ul class="space-y-2 machine text-step--1">
            <li><a href="mailto:engagements@redghostops.com" class="hover:text-critical-text transition-colors">engagements@redghostops.com</a></li>
            <li><a href="https://x.com/r3is42" rel="noopener" target="_blank" class="hover:text-critical-text transition-colors">x.com/r3is42</a></li>
            <li><a href="https://github.com/marcocarolasec" rel="noopener" target="_blank" class="hover:text-critical-text transition-colors">github.com/marcocarolasec</a></li>
          </ul>
        </div>
      </div>

      <div class="border-t border-rule pt-6 text-step--1 text-muted">
        © 2026 REDOPS Security Ltd.
      </div>
    </div>
  </footer>

  <script>
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => {
      const open = menu?.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
  </script>
</body>
</html>
