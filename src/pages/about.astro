---
import Layout from '../layouts/Layout.astro';
import { bookUrl, CTA_LABEL } from '../data/site';

// The credentials band. Badges are shown as issued (no recolouring) and
// link to the issuer's verification page on credential.net. Items without
// a badge render as a typographic tile of the same footprint; drop a
// `badge` path in to swap the tile for the image (CEH is waiting on its PNG).
type Cred = { code: string; name: string; issuer: string; badge?: string; href?: string; mark?: string };
const creds: Cred[] = [
  { code: 'OSEP', name: 'Offensive Security Experienced Penetration Tester', issuer: 'OffSec, 2026', badge: '/badges/osep.png', href: 'https://www.credential.net/9a744c32-be17-45b6-98be-79cb304296a5#acc.ARa97kdy' },
  { code: 'OSCP', name: 'Offensive Security Certified Professional', issuer: 'OffSec, 2023', badge: '/badges/oscp.png', href: 'https://www.credential.net/aea87c4e-59c4-430c-86d4-38cf0a00112b#acc.doP0DjcQ' },
  { code: 'CRTP', name: 'Certified Red Team Professional', issuer: 'Pentester Academy, 2022', badge: '/badges/crtp.png', href: 'https://www.credential.net/5fa454b3-6490-4049-bc45-ecb2b5e9725c#acc.uQSM7VnY' },
  { code: 'OSWP', name: 'Offensive Security Wireless Professional', issuer: 'OffSec, 2023', badge: '/badges/oswp.png', href: 'https://www.credential.net/f6b151bb-63de-4546-a8c2-8c9169b16677#acc.8bsBtuNV' },
  { code: 'CEH', name: 'Certified Ethical Hacker', issuer: 'EC-Council, 2022', badge: '/badges/ceh.png' },
  { code: '10 CVEs', name: 'Published vulnerabilities', issuer: 'MITRE and INCIBE', mark: '10' },
];

const career = [
  ['2026 – present', 'REDOPS Security Ltd.', 'Founder and lead consultant', 'Red team operations, Active Directory testing, web application security, and infrastructure assessments for international clients.'],
  ['2024 – present', 'AuditOne GmbH, Germany', 'Head of Security (2026), platform auditor', 'Security leadership for a Web3 audit aggregator with 500+ auditors. Pen-tests and wallet audits with public reports, including Bloom Wallet and Cybar.'],
  ['2022 – 2026', 'Telefónica Tech', 'Senior offensive security engineer', 'Full-spectrum pentesting across Active Directory, web, API, cloud, mobile, IoT, wireless, and infrastructure. LLM security testing and social engineering campaigns.'],
  ['2021 – 2022', 'Assured Clarity Limited, UK', 'Offensive security instructor', 'Hands-on training: penetration testing with Burp Suite, AWS security assessment, OSINT, threat modeling.'],
  ['2019 – 2022', 'Bullhost Cloud Services', 'Offensive security engineer', 'Pentesting, web and API audits, vulnerability management, incident response, and SOC monitoring.'],
];
---

<Layout
  title="About — REDOPS Security"
  description="REDOPS Security is a small, senior-only offensive security consultancy registered in Cyprus, EU. Led by the Head of Security at AuditOne, formerly Telefónica Tech. OSEP and OSCP, ten published CVEs."
  path="/about/"
>
  <section class="wrap pt-20 md:pt-28 pb-16">
    <div class="rise">
      <h1 class="text-step-5 display max-w-[16ch]">Built by operators, not auditors.</h1>
      <p class="lede measure mt-8">
        REDOPS Security is a small offensive security consultancy registered in Cyprus, EU. Senior operators only, no bench of juniors. Focused, technically deep engagements, and nothing else.
      </p>
    </div>
  </section>

  <section class="section border-t border-rule">
    <div class="wrap">
      <h2 class="text-step-3 display">Asier Barranco</h2>
      <p class="text-muted mt-1">Founder and lead consultant · Head of Security at <a href="https://www.auditone.io/company" target="_blank" rel="noopener" class="link-quiet">AuditOne</a></p>
      <p class="mt-6 measure-wide">
        Six years of full-time offensive security across Spanish telecom, boutique consultancies, and international red team engagements. Four years as senior offensive security engineer at Telefónica Tech, leading penetration tests across Active Directory, web applications, cloud, mobile, and infrastructure for international clients. Today Head of Security at AuditOne, the Web3 audit aggregator, where he also audits at Expert level with a <a href="https://auditor.auditone.io/u/asier" target="_blank" rel="noopener" class="link-quiet">public findings record</a>.
      </p>
      <p class="mt-4 measure-wide text-muted">
        Specialties: modern Active Directory attack chains, EDR evasion against Sophos, CrowdStrike, and SentinelOne, custom loader development, and web application security at depth. Works in English and Spanish.
      </p>
    </div>
  </section>

  <section class="border-t border-rule bg-paper-raised">
    <div class="wrap py-16 md:py-20">
      <h2 class="text-step-3 display max-w-[18ch]">Certifications an auditor will recognize.</h2>

      <ul class="mt-10 flex items-start gap-5 md:gap-6 overflow-x-auto snap-x snap-mandatory -mx-6 px-6 md:mx-0 md:px-0 pb-3">
        {creds.map((c) => {
          const tile = (
            <span class="flex items-center justify-center w-36 h-36 bg-paper border border-rule transition-colors group-hover:border-muted">
              {c.badge
                ? <img src={c.badge} alt={c.code} width="96" height="96" loading="lazy" class="badge h-24 w-24 object-contain" />
                : (
                  <span class="flex flex-col items-center justify-center machine leading-none">
                    <span class="text-step-4">{c.mark ?? c.code}</span>
                    {c.mark && <span class="mt-2 text-step--1 text-muted">CVEs</span>}
                  </span>
                )}
            </span>
          );
          const label = <span class="block mt-3 text-step--1 text-muted">{c.issuer}</span>;
          return (
            <li class="shrink-0 snap-center w-36">
              {c.href
                ? <a href={c.href} target="_blank" rel="noopener" title={c.name} class="group block">{tile}{label}</a>
                : <div title={c.name}>{tile}{label}</div>}
            </li>
          );
        })}
      </ul>

      <p class="mt-6 text-step--1 text-muted">
        Hover a badge to see it in color. Each one opens its credential on credential.net. Research at <a href="https://blog.redghostops.com" rel="noopener" target="_blank" class="link-quiet">blog.redghostops.com</a>.
      </p>
    </div>
  </section>

  <section class="section border-t border-rule">
    <div class="wrap">
      <h2 class="text-step-3 display">Field history.</h2>
      <ol class="mt-10 divide-y divide-rule border-t border-b border-rule max-w-4xl">
        {career.map(([when, org, role, body]) => (
          <li class="py-6 grid md:grid-cols-[9rem_1fr] gap-x-8 gap-y-1">
            <span class="machine text-step--1 text-muted pt-1">{when}</span>
            <div>
              <p class="font-medium">{org}<span class="text-muted font-normal"> — {role}</span></p>
              <p class="mt-1 text-muted text-step--1 measure-wide">{body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section border-t border-rule">
    <div class="wrap grid md:grid-cols-2 gap-x-16 gap-y-12">
      <div>
        <h2 class="text-step-2 display">Who this is for.</h2>
        <ul class="mt-6 space-y-4 text-muted measure">
          <li><span class="text-ink font-medium">SaaS and fintech</span> with real attack surface and customer data to protect.</li>
          <li><span class="text-ink font-medium">Regulated industries</span> that need actual security as well as the compliance evidence.</li>
          <li><span class="text-ink font-medium">Mid-market teams</span> of 50 to 2,000 people with in-house IT or security, and boutique consultancies subcontracting senior capacity.</li>
        </ul>
      </div>
      <div>
        <h2 class="text-step-2 display">What this is not.</h2>
        <ul class="mt-6 space-y-4 text-muted measure">
          <li><span class="text-ink font-medium">Scanner reports.</span> If a Nessus license can do it, this is the wrong vendor.</li>
          <li><span class="text-ink font-medium">Junior-led engagements.</span> A senior operator does every hour of the work, and the same one from kickoff to retest.</li>
          <li><span class="text-ink font-medium">Grey-zone work.</span> Nothing runs without written authorization.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section border-t border-rule">
    <div class="wrap">
      <h2 class="text-step-3 display">The entity.</h2>
      <dl class="mt-8 grid sm:grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-6 max-w-4xl text-step--1">
        <div><dt class="text-muted">Company</dt><dd class="mt-1">REDOPS Security Ltd.</dd></div>
        <div><dt class="text-muted">Registration</dt><dd class="mt-1 machine">HE 491541</dd></div>
        <div><dt class="text-muted">Jurisdiction</dt><dd class="mt-1">Cyprus, EU. GDPR applies.</dd></div>
        <div><dt class="text-muted">Invoicing</dt><dd class="mt-1">EUR, USD, or stablecoin</dd></div>
      </dl>
      <p class="mt-8 text-muted measure-wide">
        Clients across the EU, UK, USA, and Latin America; see the <a href="/clients/" class="link-quiet">track record</a>. Standard MSA and SOW in English and Spanish. NDA signed before any technical discussion. 50% at signature, 50% on delivery.
      </p>
    </div>
  </section>

  <section class="section border-t border-rule">
    <div class="wrap">
      <h2 class="text-step-4 display max-w-[18ch]">Want to talk scope?</h2>
      <p class="lede measure mt-6">Thirty minutes, NDA first. You talk to the operator, not a salesperson.</p>
      <a href={bookUrl()} target="_blank" rel="noopener" class="btn-primary mt-10 text-step-0">{CTA_LABEL}</a>
    </div>
  </section>
</Layout>
