---
import Layout from '../layouts/Layout.astro';
import { bookUrl, CTA_LABEL } from '../data/site';

// Official issuer badges, shown as issued: no recolouring, uniform height.
// Order is strongest signal first. Add `href` with the verification URL
// when available; the strip renders each as a link automatically.
const badges = [
  { src: '/badges/osep.png', alt: 'OffSec OSEP badge, Offensive Security Experienced Penetration Tester' },
  { src: '/badges/oscp.png', alt: 'OffSec OSCP badge, Offensive Security Certified Professional' },
  { src: '/badges/crtp.png', alt: 'CRTP badge, Certified Red Team Professional' },
  { src: '/badges/oswp.png', alt: 'OffSec OSWP badge, Offensive Security Wireless Professional' },
] as { src: string; alt: string; href?: string }[];

const certs = [
  ['OSEP', 'Offensive Security Experienced Penetration Tester', 'OffSec, 2026'],
  ['OSCP', 'Offensive Security Certified Professional', 'OffSec, 2023'],
  ['OSWP', 'Offensive Security Wireless Professional', 'OffSec, 2023'],
  ['CRTP', 'Certified Red Team Professional', 'Pentester Academy, 2022'],
  ['CEH', 'Certified Ethical Hacker', 'EC-Council, 2022'],
];

const career = [
  ['2026 – present', 'REDOPS Security Ltd.', 'Founder and lead consultant', 'Red team operations, Active Directory testing, web application security, and infrastructure assessments for international clients.'],
  ['2022 – 2026', 'Telefónica Tech', 'Senior offensive security engineer', 'Full-spectrum pentesting across Active Directory, web, API, cloud, mobile, IoT, wireless, and infrastructure. LLM security testing and social engineering campaigns.'],
  ['2021 – 2022', 'Assured Clarity Limited, UK', 'Offensive security instructor', 'Hands-on training: penetration testing with Burp Suite, AWS security assessment, OSINT, threat modeling.'],
  ['2019 – 2022', 'Bullhost Cloud Services', 'Offensive security engineer', 'Pentesting, web and API audits, vulnerability management, incident response, and SOC monitoring.'],
];
---

<Layout
  title="About — REDOPS Security"
  description="REDOPS Security is a one-operator offensive security consultancy registered in Cyprus, EU. Six years of full-time offensive work, OSEP and OSCP, ten published CVEs."
  path="/about/"
>
  <section class="wrap pt-20 md:pt-28 pb-16">
    <div class="rise">
      <h1 class="text-step-5 display max-w-[16ch]">Built by an operator, not an auditor.</h1>
      <p class="lede measure mt-8">
        REDOPS Security is a one-person offensive security consultancy registered in Cyprus, EU. Focused, technically deep engagements, and nothing else.
      </p>
    </div>
  </section>

  <section class="section border-t border-rule">
    <div class="wrap grid md:grid-cols-[1fr_1fr] gap-x-16 gap-y-10">
      <div>
        <h2 class="text-step-3 display">Asier Barranco</h2>
        <p class="text-muted mt-1">Founder and lead consultant</p>
        <p class="mt-6 measure">
          Six years of full-time offensive security across Spanish telecom, boutique consultancies, and international red team engagements. Most recently senior offensive security engineer at Telefónica Tech, leading penetration tests across Active Directory, web applications, cloud, mobile, and infrastructure for international clients.
        </p>
        <p class="mt-4 measure text-muted">
          Specialties: modern Active Directory attack chains, EDR evasion against Sophos, CrowdStrike, and SentinelOne, custom loader development, and web application security at depth. Works in English and Spanish.
        </p>
      </div>
      <div>
        <h2 class="text-step-1 font-medium">Verifiable, before you sign anything.</h2>
        <ul class="mt-5 divide-y divide-rule border-t border-b border-rule text-step--1">
          {certs.map(([code, name, issuer]) => (
            <li class="py-3 grid grid-cols-[4.5rem_1fr] gap-4">
              <span class="machine">{code}</span>
              <span>{name}<span class="text-muted"> · {issuer}</span></span>
            </li>
          ))}
          <li class="py-3 grid grid-cols-[4.5rem_1fr] gap-4">
            <span class="machine">10 CVEs</span>
            <span>MITRE and INCIBE assigned<span class="text-muted"> · CVE-2024-8161 and nine more</span></span>
          </li>
        </ul>
        <p class="mt-4 text-step--1 text-muted">
          OSEP is verifiable on the OffSec certification page. Research at <a href="https://blog.redghostops.com" rel="noopener" target="_blank" class="link-quiet">blog.redghostops.com</a>.
        </p>
      </div>

      <div class="md:col-span-2 mt-2 pt-10 border-t border-rule">
        <ul role="list" class="flex items-center gap-10 md:gap-14 overflow-x-auto snap-x snap-mandatory -mx-6 px-6 md:mx-0 md:px-0 pb-2">
          {badges.map((b) => (
            <li class="shrink-0 snap-center">
              {b.href ? (
                <a href={b.href} target="_blank" rel="noopener" class="block transition-transform hover:-translate-y-0.5 motion-reduce:transform-none">
                  <img src={b.src} alt={b.alt} width="112" height="112" loading="lazy" class="h-24 md:h-28 w-auto" />
                </a>
              ) : (
                <img src={b.src} alt={b.alt} width="112" height="112" loading="lazy" class="h-24 md:h-28 w-auto" />
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section border-t border-rule">
    <div class="wrap">
      <h2 class="text-step-3 display">Field history.</h2>
      <ol class="mt-10 divide-y divide-rule border-t border-b border-rule max-w-4xl">
        {career.map(([when, org, role, body]) => (
          <li class="py-6 grid md:grid-cols-[9rem_1fr] gap-x-8 gap-y-1">
            <span class="machine text-step--1 text-muted pt-1">{when}</span>
            <div>
              <p class="font-medium">{org}<span class="text-muted font-normal"> — {role}</span></p>
              <p class="mt-1 text-muted text-step--1 measure-wide">{body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section border-t border-rule">
    <div class="wrap grid md:grid-cols-2 gap-x-16 gap-y-12">
      <div>
        <h2 class="text-step-2 display">Who this is for.</h2>
        <ul class="mt-6 space-y-4 text-muted measure">
          <li><span class="text-ink font-medium">SaaS and fintech</span> with real attack surface and customer data to protect.</li>
          <li><span class="text-ink font-medium">Regulated industries</span> that need actual security as well as the compliance evidence.</li>
          <li><span class="text-ink font-medium">Mid-market teams</span> of 50 to 2,000 people with in-house IT or security, and boutique consultancies subcontracting senior capacity.</li>
        </ul>
      </div>
      <div>
        <h2 class="text-step-2 display">What this is not.</h2>
        <ul class="mt-6 space-y-4 text-muted measure">
          <li><span class="text-ink font-medium">Scanner reports.</span> If a Nessus license can do it, this is the wrong vendor.</li>
          <li><span class="text-ink font-medium">Junior-led engagements.</span> The same senior operator does every hour of the work.</li>
          <li><span class="text-ink font-medium">Grey-zone work.</span> Nothing runs without written authorization.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section border-t border-rule">
    <div class="wrap">
      <h2 class="text-step-3 display">The entity.</h2>
      <dl class="mt-8 grid sm:grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-6 max-w-4xl text-step--1">
        <div><dt class="text-muted">Company</dt><dd class="mt-1">REDOPS Security Ltd.</dd></div>
        <div><dt class="text-muted">Registration</dt><dd class="mt-1 machine">HE 491541</dd></div>
        <div><dt class="text-muted">Jurisdiction</dt><dd class="mt-1">Cyprus, EU. GDPR applies.</dd></div>
        <div><dt class="text-muted">Invoicing</dt><dd class="mt-1">EUR, USD, or stablecoin</dd></div>
      </dl>
      <p class="mt-8 text-muted measure-wide">
        Clients across the EU, UK, USA, and Latin America. Standard MSA and SOW in English and Spanish. NDA signed before any technical discussion. 50% at signature, 50% on delivery.
      </p>
    </div>
  </section>

  <section class="section border-t border-rule">
    <div class="wrap">
      <h2 class="text-step-4 display max-w-[18ch]">Want to talk scope?</h2>
      <p class="lede measure mt-6">Thirty minutes, NDA first. You talk to the operator, not a salesperson.</p>
      <a href={bookUrl()} target="_blank" rel="noopener" class="btn-primary mt-10 text-step-0">{CTA_LABEL}</a>
    </div>
  </section>
</Layout>
