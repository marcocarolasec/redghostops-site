    </div>
  </section>

  <!-- PROCESS -->
  <section class="py-32 border-t border-ash-lighter">
    <div class="max-w-7xl mx-auto px-6">
      <div class="num-label mb-4">// PROCESS</div>
      <h2 class="font-display text-4xl md:text-5xl font-bold mb-16 max-w-3xl">
        How engagements<br />
        <span class="text-blood">flow.</span>
      </h2>

      <div class="grid md:grid-cols-4 gap-6">
        <div class="reveal">
          <div class="font-mono text-blood text-3xl font-bold mb-4">01</div>
          <h3 class="font-display text-lg font-bold mb-3">Scoping Call</h3>
          <p class="text-ghost-light text-sm leading-relaxed">
            30-min discovery to understand objectives, scope, constraints. NDA signed before any technical details discussed.
          </p>
        </div>
        <div class="reveal">
          <div class="font-mono text-blood text-3xl font-bold mb-4">02</div>
          <h3 class="font-display text-lg font-bold mb-3">Proposal & Contract</h3>
          <p class="text-ghost-light text-sm leading-relaxed">
            Fixed-price proposal matching the published package, with scope, timeline, and deliverables. Standard MSA + SOW. 50% upfront, 50% on delivery.
          </p>
        </div>
        <div class="reveal">
          <div class="font-mono text-blood text-3xl font-bold mb-4">03</div>
          <h3 class="font-display text-lg font-bold mb-3">Execution</h3>
          <p class="text-ghost-light text-sm leading-relaxed">
            Active testing with daily status updates on critical findings. Live channel for coordination during engagement.
          </p>
        </div>
        <div class="reveal">
          <div class="font-mono text-blood text-3xl font-bold mb-4">04</div>
          <h3 class="font-display text-lg font-bold mb-3">Delivery</h3>
          <p class="text-ghost-light text-sm leading-relaxed">
            Written report + technical walkthrough call. Free retest within 30 days to verify remediation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="py-32 border-t border-ash-lighter">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <h2 class="font-display text-4xl md:text-6xl font-bold mb-8 leading-tight">
        Engagement starts<br />
        <span class="text-blood">with a 30-min call.</span>
      </h2>
      <a href={`${base}contact`} class="cta-primary">
        Request Scoping Call →
      </a>
    </div>
  </section>
</Layout>
