---
import Layout from '../layouts/Layout.astro';
import { services, entry, addons, recurring, terms, dayRate, eur } from '../data/pricing';
import { bookUrl, CTA_LABEL } from '../data/site';

const detail = {
  'web-pentest': {
    summary: 'Manual testing of web applications and APIs. Authentication and session flows, business logic, authorization (IDOR/BOLA), race conditions, server-side injection chains. REST, GraphQL, and WebSocket.',
    covers: ['OWASP Top 10 and ASVS', 'Authentication, session, and authorization', 'Business logic and chained exploitation'],
    delivers: ['Findings with CVSS scores and reproduction steps', 'Remediation written for your stack', 'Free retest within 30 days'],
    format: 'Remote',
  },
  'external-pentest': {
    summary: 'Your internet-facing infrastructure from an external attacker’s position. OSINT-driven recon, active enumeration, exploit validation, and post-exploitation where scope allows.',
    covers: ['Subdomain and service enumeration', 'CVE validation and exploitation', 'Cloud asset and credential exposure'],
    delivers: ['Attack surface inventory', 'Verified findings and exposed credentials', 'Free retest within 30 days'],
    format: 'Remote',
  },
  'ad-assessment': {
    summary: 'Internal assessment from an assumed foothold, with the goal of Domain Admin and Tier-0 assets. Maps the paths a real attacker would take, not a list of theoretical weaknesses.',
    covers: ['Kerberos attacks, roasting, delegation abuse', 'ACL and GPO abuse chains', 'Relay attacks, lateral movement, privilege escalation'],
    delivers: ['Attack path documentation with BloodHound graphs', 'Prioritized remediation roadmap and detection hints', 'Free retest within 30 days'],
    format: 'Remote or on-site',
  },
  'red-team': {
    summary: 'Objective-based adversary simulation. Initial access by phishing or external exploitation, EDR evasion with custom tooling, lateral movement, and objective-driven exfiltration. Tests prevention and detection together.',
    covers: ['Phishing, custom C2, custom loaders', 'EDR evasion against Sophos, CrowdStrike, SentinelOne', 'Persistence, lateral movement, exfiltration'],
    delivers: ['Full operation narrative mapped to MITRE ATT&CK', 'IOCs and detection gap analysis for your SOC', 'Executive briefing and technical debrief'],
    format: 'Remote or on-site, 2–4 weeks',
  },
  'cloud': {
    summary: 'Offensive assessment of AWS, Azure, and GCP environments. Privilege escalation through IAM, exposed storage and serverless surface, and lateral paths between cloud and on-premises.',
    covers: ['IAM misconfiguration and escalation chains', 'Storage, serverless, and Kubernetes exposure', 'Hybrid cloud-to-on-prem paths'],
    delivers: ['Cloud attack surface map and IAM privilege graph', 'Exploitable misconfigurations with a hardening playbook', 'Free retest within 30 days'],
    format: 'Remote, 5–10 days',
  },
} as const;

const process = [
  ['Scoping call', 'Thirty minutes to understand objectives, scope, and constraints. Mutual NDA in place before any technical detail.'],
  ['Proposal and contract', 'Fixed-price proposal matching the published package. Standard MSA and SOW. 50% at signature, 50% on delivery.'],
  ['Execution', 'Active testing with same-day notice of critical findings and a direct channel to the operator throughout.'],
  ['Delivery', 'Written report and a walkthrough call with your technical team. Free retest of High and Critical findings within 30 days.'],
];
---

<Layout
  title="Services and pricing — REDOPS Security"
  description="Penetration testing, Active Directory assessment, red team operations, and cloud security assessment. Fixed scope, published prices in EUR."
  path="/services/"
>
  <section class="wrap pt-20 md:pt-28 pb-16">
    <div class="rise">
      <h1 class="text-step-5 display max-w-[16ch]">Services and pricing.</h1>
      <p class="lede measure mt-8">
        Every package includes the scoping call, execution, a written report, and a remediation walkthrough. Scope beyond a package adds days at {eur(dayRate)}, for everyone. Prices in EUR, excluding VAT.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href={bookUrl()} target="_blank" rel="noopener" class="btn-primary">{CTA_LABEL}</a>
        <a href="#pricing" class="btn-secondary">Jump to the price list</a>
      </div>
    </div>
  </section>

  <section class="section border-t border-rule" id="start">
    <div class="wrap">
      <div class="sev sev-critical py-1 max-w-4xl">
        <p class="text-step--1 text-muted">Start here</p>
        <div class="mt-2 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
          <h2 class="text-step-3 display">{entry.name}</h2>
          <div class="machine text-step-3">{eur(entry.price)}</div>
        </div>
        <p class="mt-4 measure-wide">
          Two days on your external perimeter, up to three root domains. What is exposed, outdated, misconfigured, or leaked. Validation only, no exploitation. The output is the prioritized list you would otherwise get from the first two days of a full external pentest.
        </p>
        <p class="mt-3 text-muted measure-wide">
          Priced so a CTO can sign it without a procurement cycle. If you contract a full engagement within {entry.creditWindowDays} days, the full amount is credited against it.
        </p>
        <a href={bookUrl(entry.key)} target="_blank" rel="noopener" class="btn-primary mt-6">{CTA_LABEL}</a>
      </div>
    </div>
  </section>

  <section class="section border-t border-rule" id="pricing">
    <div class="wrap">
      <h2 class="text-step-3 display">The price is the price.</h2>
      <p class="lede measure mt-4">What is published is what you pay for the scope described. A price that moves when you push is the opaque model this replaces.</p>

      <div class="mt-12 overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[640px]">
          <thead>
            <tr class="border-b border-rule text-step--1 text-muted">
              <th scope="col" class="py-3 pr-6 font-normal">Engagement</th>
              <th scope="col" class="py-3 pr-6 font-normal">Scope</th>
              <th scope="col" class="py-3 pr-6 font-normal text-right">Days</th>
              <th scope="col" class="py-3 font-normal text-right">Price</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-rule">
            <tr class="align-top">
              <th scope="row" class="py-4 pr-6 font-medium">{entry.name}</th>
              <td class="py-4 pr-6 text-muted">{entry.scope}</td>
              <td class="py-4 pr-6 machine text-right">{entry.days}</td>
              <td class="py-4 machine text-right">{eur(entry.price)}</td>
            </tr>
            {services.flatMap((s) =>
              s.tiers.map((t) => (
                <tr class="align-top">
                  <th scope="row" class="py-4 pr-6 font-medium">
                    <a href={`#${s.key}`} class="hover:text-critical-text transition-colors">{s.name}</a>
                    {t.label && <span class="text-muted font-normal"> — {t.label}</span>}
                  </th>
                  <td class="py-4 pr-6 text-muted">{t.scope}</td>
                  <td class="py-4 pr-6 machine text-right">{t.days ?? '—'}</td>
                  <td class="py-4 machine text-right">{t.price === null ? <span class="text-muted">after scoping</span> : eur(t.price)}</td>
                </tr>
              ))
            )}
            {addons.map((a) => (
              <tr class="align-top">
                <th scope="row" class="py-4 pr-6 font-medium">{a.name}</th>
                <td class="py-4 pr-6 text-muted">{a.scope}</td>
                <td class="py-4 pr-6 machine text-right">{a.days}</td>
                <td class="py-4 machine text-right">{eur(a.price)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <dl class="mt-12 grid md:grid-cols-2 gap-x-12 gap-y-6 max-w-4xl text-step--1">
        <div>
          <dt class="font-medium">Payment</dt>
          <dd class="text-muted mt-1">50% at signature, 50% on delivery for new clients. NET-30 for established clients. EUR, USD, or stablecoin.</dd>
        </div>
        <div>
          <dt class="font-medium">Bundles</dt>
          <dd class="text-muted mt-1">{terms.bundle[0].pct}% off two services contracted in the same quarter, {terms.bundle[1].pct}% off three. Published, so nobody has to ask.</dd>
        </div>
        <div>
          <dt class="font-medium">Retest</dt>
          <dd class="text-muted mt-1">High and Critical findings re-verified free within 30 days of delivery, on every assessment.</dd>
        </div>
        <div>
          <dt class="font-medium">VAT</dt>
          <dd class="text-muted mt-1">Invoiced by REDOPS Security Ltd., Cyprus. EU B2B clients: reverse charge, no VAT added. Outside the EU: no VAT.</dd>
        </div>
      </dl>
    </div>
  </section>

  {services.map((s) => {
    const d = detail[s.key as keyof typeof detail];
    return (
      <section class="section border-t border-rule" id={s.key}>
        <div class="wrap grid md:grid-cols-[1fr_1fr] gap-x-16 gap-y-8">
          <div>
            <h2 class="text-step-3 display">{s.name}</h2>
            <p class="text-muted text-step--1 mt-2">{d.format}</p>
            <p class="mt-6 measure">{d.summary}</p>
            <div class="mt-6 flex flex-wrap items-center gap-6">
              <a href={bookUrl(s.key)} target="_blank" rel="noopener" class="btn-primary">{CTA_LABEL}</a>
              <a href="#pricing" class="link-quiet text-step--1">Price list</a>
            </div>
          </div>
          <div class="grid sm:grid-cols-2 gap-8 text-step--1">
            <div>
              <p class="font-medium">Covers</p>
              <ul class="mt-2 space-y-1.5 text-muted">
                {d.covers.map((c) => <li>{c}</li>)}
              </ul>
            </div>
            <div>
              <p class="font-medium">You get</p>
              <ul class="mt-2 space-y-1.5 text-muted">
                {d.delivers.map((c) => <li>{c}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>
    );
  })}

  <section class="section border-t border-rule" id="continuous">
    <div class="wrap">
      <h2 class="text-step-3 display">Continuous offensive testing.</h2>
      <p class="lede measure mt-4">For teams shipping every week. The perimeter changes faster than an annual pentest can see, so the operator keeps watching it.</p>

      <div class="mt-12 grid md:grid-cols-2 gap-8 max-w-4xl">
        {recurring.map((plan) => (
          <div class="border border-rule p-7">
            <div class="flex items-baseline justify-between gap-6">
              <h3 class="text-step-1 font-medium">{plan.name}</h3>
              <div class="machine text-step-1">{eur(plan.monthly)}<span class="text-muted text-step--1"> /month</span></div>
            </div>
            <ul class="mt-5 space-y-2 text-step--1 text-muted">
              {plan.includes.map((i) => <li>{i}</li>)}
            </ul>
            <a href={bookUrl(plan.key)} target="_blank" rel="noopener" class="btn-secondary mt-7 w-full">{CTA_LABEL}</a>
          </div>
        ))}
      </div>
      <p class="mt-6 text-step--1 text-muted measure-wide">
        {terms.commitmentMonths}-month commitment, billed monthly. {terms.annualPrepayDiscount}% off for annual prepayment. Excluding VAT.
      </p>
    </div>
  </section>

  <section class="section border-t border-rule">
    <div class="wrap">
      <h2 class="text-step-3 display">How an engagement runs.</h2>
      <ol class="mt-12 grid md:grid-cols-2 gap-x-12 gap-y-10 max-w-4xl">
        {process.map(([title, body], i) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-4">
            <span class="machine text-muted pt-1">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <p class="font-medium">{title}</p>
              <p class="mt-1 text-muted text-step--1">{body}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="mt-10 text-muted measure-wide">
        Something not on this page? Mobile, source code review, phishing simulation, IoT, M&amp;A due diligence, and vCISO advisory are scoped in days at {eur(dayRate)} a day. Bring it to the call.
      </p>
    </div>
  </section>

  <section class="section border-t border-rule">
    <div class="wrap">
      <h2 class="text-step-4 display max-w-[18ch]">Every engagement starts with the same call.</h2>
      <p class="lede measure mt-6">Thirty minutes, NDA first, written proposal within 48 hours if you want one.</p>
      <a href={bookUrl()} target="_blank" rel="noopener" class="btn-primary mt-10 text-step-0">{CTA_LABEL}</a>
    </div>
  </section>
</Layout>
