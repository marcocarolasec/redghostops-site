---
import Layout from '../layouts/Layout.astro';
import { bookUrl, CTA_LABEL } from '../data/site';
import { clients, KIND_LABEL } from '../data/clients';

// A wall of marks, one tile per organisation, all the same size. The tile
// carries the logo, the name, one line on the relationship and the public
// source. Anything longer belongs on a call, not here.
const order = ['employer', 'platform', 'client', 'institution', 'partner'] as const;
const wall = [...clients].sort((a, b) => order.indexOf(a.kind) - order.indexOf(b.kind));
---

<Layout
  title="Clients — REDOPS Security"
  description="Organisations REDOPS Security has worked for, in-house and as a vendor: Telefónica Tech, AuditOne, Bloom Wallet, INCIBE, Bullhost, SPRI, Assured Clarity, PC Seguridad."
  path="/clients/"
>
  <section class="wrap pt-20 md:pt-28 pb-12">
    <div class="rise">
      <h1 class="text-step-5 display max-w-[16ch]">Where we have worked.</h1>
      <p class="lede measure mt-8">
        In-house, as a vendor and through public programmes. Each mark links to the public source; the rest is under NDA and available as a reference on request.
      </p>
    </div>
  </section>

  <section class="wrap pb-20 md:pb-28">
    <ul class="grid grid-cols-2 md:grid-cols-3 gap-px bg-rule border border-rule">
      {wall.map((c) => (
        <li class="bg-paper">
          <a
            href={c.href ?? '/clients/'}
            target={c.href ? '_blank' : undefined}
            rel={c.href ? 'noopener' : undefined}
            class="group flex flex-col h-full p-6 md:p-8 transition-colors hover:bg-paper-raised"
          >
            <span class="flex items-center justify-center h-24 md:h-28">
              {c.logo
                ? <img src={c.logo} alt={c.name} style={`height:${Math.round((c.logoH ?? 26) * 1.35)}px`} class="w-auto max-w-[85%] logo-mono opacity-70 group-hover:opacity-100 transition-opacity" loading="lazy" />
                : <span class="display text-step-2 tracking-tight opacity-70 group-hover:opacity-100 transition-opacity">{c.name}</span>}
            </span>
            <span class="mt-6 pt-5 border-t border-rule">
              <span class="block font-semibold tracking-tight">{c.name}</span>
              <span class="block mt-1 text-step--1 text-muted">{c.relation}</span>
              <span class="block mt-3 machine text-[0.68rem] uppercase tracking-wider text-muted">{KIND_LABEL[c.kind]}{c.since ? ` · ${c.since}` : ''}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-step--1 text-muted">
      Marks belong to their owners and are shown to state a working relationship, not an endorsement.
    </p>
  </section>

  <section class="section border-t border-rule">
    <div class="wrap">
      <h2 class="text-step-4 display max-w-[18ch]">Want to talk scope?</h2>
      <p class="lede measure mt-6">Thirty minutes, NDA first. You talk to the operator, not a salesperson.</p>
      <a href={bookUrl()} target="_blank" rel="noopener" class="btn-primary mt-10 text-step-0">{CTA_LABEL}</a>
    </div>
  </section>
</Layout>
