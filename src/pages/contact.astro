---
import Layout from '../layouts/Layout.astro';
import { dayRate, terms, eur } from '../data/pricing';
import { CALENDLY_URL, CTA_LABEL, EMAIL } from '../data/site';

const steps = [
  'Pick a slot in the calendar.',
  'A mutual NDA reaches your inbox within 24 hours.',
  'Thirty-minute call on Zoom, Meet, or Teams.',
  'Written proposal within 48 hours, if you ask for one.',
  'MSA and SOW signed. 50% at signature.',
  'Kickoff, usually one to two weeks after signature.',
];

const faq = [
  ['How quickly can an engagement start?', 'Earliest calendar availability is usually the same week. Proposal within 48 hours of the call, contract in five to ten business days depending on your procurement, kickoff one to two weeks after signature.'],
  ['Do you sign an NDA before discussing scope?', 'Always. No technical detail about your environment is discussed without a mutual NDA in place. There is a standard template ready, or we use yours.'],
  ['Are the published prices real?', `Yes. The price on the services page is what the scope described costs, excluding VAT. Larger scope adds days at ${eur(dayRate)}. Two services in the same quarter get ${terms.bundle[0].pct}% off, three get ${terms.bundle[1].pct}%, and annual prepayment on retainers gets ${terms.annualPrepayDiscount}%.`],
  ['How is it invoiced?', 'Through REDOPS Security Ltd., registered in Cyprus, EU. EUR, USD, or stablecoin. 50% at signature, 50% on delivery. NET-30 for established clients.'],
  ['What is in the report?', 'An executive summary, technical findings with CVSS v3.1 scores, step-by-step reproduction with evidence, business impact, and prioritized remediation written for your stack. It satisfies auditors and it is usable by the team that has to fix things.'],
  ['Is the free retest really free?', 'Yes. Within 30 days of delivery, remediation of all High and Critical findings is re-verified at no cost, on every assessment-style service.'],
  ['Do you work outside the EU?', 'Yes. Clients across the EU, UK, USA, and Latin America. Documentation in English and Spanish. Remote is standard; on-site is available for Active Directory and red team work where logistics make sense.'],
];
---

<Layout
  title="Book a scoping call — REDOPS Security"
  description="Book a thirty-minute scoping call with the operator. Mutual NDA before the call, written proposal within 48 hours."
  path="/contact/"
>
  <section class="wrap pt-20 md:pt-28 pb-16">
    <div class="rise">
      <h1 class="text-step-5 display max-w-[16ch]">Book a scoping call.</h1>
      <p class="lede measure mt-8">
        Thirty minutes with the person who will do the testing. A mutual NDA goes out before the call, so we can talk about your actual environment.
      </p>

      <div id="service-context" class="hidden mt-6 sev sev-critical py-1 text-step--1">
        <span class="text-muted">Service of interest:</span> <span id="service-label" class="font-medium"></span>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-6">
        <a id="calendly-link" href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" class="btn-primary text-step-0">{CTA_LABEL}</a>
        <span class="text-step--1 text-muted">Opens Calendly in a new tab. Earliest slots are usually this week.</span>
      </div>
    </div>
  </section>

  <section class="section border-t border-rule">
    <div class="wrap grid md:grid-cols-2 gap-x-16 gap-y-12">
      <div>
        <h2 class="text-step-2 display">What happens next.</h2>
        <ol class="mt-6 space-y-3">
          {steps.map((s, i) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-3">
              <span class="machine text-muted">{String(i + 1).padStart(2, '0')}</span>
              <span>{s}</span>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <h2 class="text-step-2 display">Prefer another channel?</h2>
        <dl class="mt-6 space-y-5 text-step--1">
          <div>
            <dt class="font-medium">Email</dt>
            <dd class="mt-1"><a href={`mailto:${EMAIL}?subject=Scoping%20call%20request`} class="machine link-quiet">{EMAIL}</a></dd>
            <dd class="mt-1 text-muted">Reply within 24 hours. Best if you need procurement sign-off before booking.</dd>
          </div>
          <div>
            <dt class="font-medium">LinkedIn</dt>
            <dd class="mt-1"><a href="https://www.linkedin.com/in/asierbarranco-66b05a187/" target="_blank" rel="noopener" class="machine link-quiet">/in/asierbarranco</a></dd>
            <dd class="mt-1 text-muted">Direct messages welcome for B2B enquiries.</dd>
          </div>
        </dl>
        <p class="mt-8 text-step--1 text-muted measure">
          Bookings run through Calendly. Nothing you share is passed to third parties, and no technical scope is discussed before the NDA.
        </p>
      </div>
    </div>
  </section>

  <section class="section border-t border-rule">
    <div class="wrap">
      <h2 class="text-step-3 display">Common questions.</h2>
      <div class="mt-8 divide-y divide-rule border-t border-b border-rule max-w-4xl">
        {faq.map(([q, a]) => (
          <details class="group py-5">
            <summary class="cursor-pointer list-none flex items-baseline justify-between gap-6 font-medium hover:text-critical-text transition-colors">
              <span>{q}</span>
              <span class="machine text-muted group-open:hidden" aria-hidden="true">+</span>
              <span class="machine text-muted hidden group-open:inline" aria-hidden="true">−</span>
            </summary>
            <p class="mt-3 text-muted measure-wide">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section border-t border-rule">
    <div class="wrap">
      <h2 class="text-step-4 display max-w-[18ch]">Pick a slot.</h2>
      <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" class="btn-primary mt-8 text-step-0">{CTA_LABEL}</a>
    </div>
  </section>

  <script is:inline>
    (function () {
      const params = new URLSearchParams(window.location.search);
      const service = params.get('service');
      if (!service) return;
      const labels = {
        'attack-surface-review': 'Attack Surface Review',
        'web-pentest': 'Web Application Pentest',
        'ad-assessment': 'Active Directory Assessment',
        'external-pentest': 'External Network Pentest',
        'red-team': 'Red Team Operations',
        'cloud': 'Cloud Security Assessment',
        'watch': 'Watch (continuous monitoring)',
        'watch-verify': 'Watch + Verify (continuous monitoring and quarterly retest)',
        'custom': 'Custom engagement',
      };
      const labelEl = document.getElementById('service-label');
      const ctxEl = document.getElementById('service-context');
      if (labelEl && ctxEl) {
        labelEl.textContent = labels[service] || service;
        ctxEl.classList.remove('hidden');
      }
      const link = document.getElementById('calendly-link');
      if (link) {
        const url = new URL(link.href);
        url.searchParams.set('utm_content', service);
        link.href = url.toString();
      }
    })();
  </script>
</Layout>
