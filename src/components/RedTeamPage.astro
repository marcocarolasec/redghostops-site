---
// Body of the Red Team page, rendered once per language. Copy lives in
// data/redteam.ts; this file holds layout only.
import { redteamCopy, REDTEAM_PATH, REDTEAM_ANCHOR, LANG_NAME, type Lang } from '../data/redteam';
import { bookUrl, EMAIL, CTA_LABEL } from '../data/site';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = redteamCopy[lang];
const langs: Lang[] = ['es', 'en'];

const book = lang === 'es' ? 'Reserva una llamada de scoping gratuita' : CTA_LABEL;
const emailLabel = lang === 'es' ? '¿Prefieres correo?' : 'Prefer email?';
---

<section class="wrap pt-20 md:pt-28 pb-16">
  <div class="rise">
    <p class="text-step--1 text-muted">
      {langs.map((l, i) => (
        <>
          {i > 0 && <span class="px-2 text-rule" aria-hidden="true">/</span>}
          {l === lang
            ? <span class="text-ink font-medium" aria-current="true">{LANG_NAME[l]}</span>
            : <a href={REDTEAM_PATH[l]} hreflang={l} lang={l} class="link-quiet">{LANG_NAME[l]}</a>}
        </>
      ))}
    </p>

    <p class="text-step--1 text-muted machine mt-6">{c.kicker}</p>
    <h1 class="text-step-5 md:text-step-6 display max-w-[15ch] mt-4">{c.h1}</h1>
    <p class="lede measure mt-8">{c.lede}</p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a href={bookUrl('red-team')} target="_blank" rel="noopener" class="btn-primary">{book}</a>
      <a href="#scenarios" class="btn-secondary">{c.ctaSecondary}</a>
    </div>
    <p class="mt-6 text-step--1 text-muted measure">{c.heroMeta}</p>
  </div>
</section>

<section class="section border-t border-rule">
  <div class="wrap">
    <h2 class="text-step-3 md:text-step-4 display max-w-[20ch]">{c.proves.heading}</h2>
    <div class="mt-12 grid md:grid-cols-2 gap-x-12 gap-y-10 max-w-4xl">
      {c.proves.items.map(([title, body]) => (
        <div class="sev sev-critical">
          <p class="font-semibold">{title}</p>
          <p class="mt-2 text-soft measure">{body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section border-t border-rule">
  <div class="wrap">
    <h2 class="text-step-3 display">{c.stages.heading}</h2>
    <p class="lede measure mt-4">{c.stages.lede}</p>
    <ol class="mt-12 grid md:grid-cols-2 gap-x-12 gap-y-10 max-w-4xl">
      {c.stages.steps.map(([title, body], i) => (
        <li class="grid grid-cols-[2.5rem_1fr] gap-4">
          <span class="machine text-muted pt-1">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <p class="font-medium">{title}</p>
            <p class="mt-1 text-muted text-step--1 measure">{body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section border-t border-rule" id="scenarios">
  <div class="wrap">
    <h2 class="text-step-3 display">{c.scenarios.heading}</h2>
    <p class="lede measure mt-4">{c.scenarios.lede}</p>

    <div class="mt-12 grid md:grid-cols-3 gap-8 max-w-5xl">
      <div>
        <p class="text-step--1 text-muted machine mb-4">{c.scenarios.adversaryLabel}</p>
        <ul class="space-y-2.5 text-soft border-t border-rule pt-4">
          {c.scenarios.adversaries.map((x) => <li>{x}</li>)}
        </ul>
      </div>
      <div>
        <p class="text-step--1 text-muted machine mb-4">{c.scenarios.wayInLabel}</p>
        <ul class="space-y-2.5 text-soft border-t border-rule pt-4">
          {c.scenarios.vectors.map((x) => <li>{x}</li>)}
        </ul>
      </div>
      <div>
        <p class="text-step--1 text-muted machine mb-4">{c.scenarios.objectiveLabel}</p>
        <ul class="space-y-2.5 text-soft border-t border-rule pt-4">
          {c.scenarios.objectives.map((x) => <li>{x}</li>)}
        </ul>
      </div>
    </div>

    <h3 class="text-step-1 font-semibold tracking-tight mt-16">{c.scenarios.examplesHeading}</h3>
    <ul class="mt-6 grid md:grid-cols-2 gap-x-12 gap-y-5 max-w-4xl">
      {c.scenarios.examples.map((x) => (
        <li class="grid grid-cols-[1.5rem_1fr] gap-3">
          <span class="text-critical-text machine" aria-hidden="true">&gt;</span>
          <span class="text-soft measure">{x}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section border-t border-rule bg-paper-raised">
  <div class="wrap">
    <p class="text-step--1 text-muted machine">{c.ransomware.kicker}</p>
    <h2 class="text-step-3 md:text-step-4 display max-w-[22ch] mt-4">{c.ransomware.heading}</h2>
    <p class="lede measure mt-6">{c.ransomware.lede}</p>

    <div class="mt-12 grid md:grid-cols-2 gap-8 max-w-4xl">
      {c.ransomware.cards.map(([title, body]) => (
        <div class="finding">
          <p class="text-step-1 font-medium tracking-tight">{title}</p>
          <p class="mt-3 text-soft measure">{body}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 max-w-4xl">
      <p class="text-step--1 text-muted">{c.ransomware.questionsLabel}</p>
      <ul class="mt-4 divide-y divide-rule border-t border-b border-rule">
        {c.ransomware.questions.map((q) => (
          <li class="py-4 grid grid-cols-[1.5rem_1fr] gap-3">
            <span class="text-critical-text machine" aria-hidden="true">?</span>
            <span class="text-soft">{q}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<section class="section border-t border-rule">
  <div class="wrap">
    <h2 class="text-step-3 display max-w-[18ch]">{c.different.heading}</h2>
    <div class="mt-12 grid md:grid-cols-2 gap-x-12 gap-y-10 max-w-4xl">
      {c.different.items.map(([title, body]) => (
        <div>
          <p class="font-semibold">{title}</p>
          <p class="mt-2 text-soft measure">{body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section border-t border-rule">
  <div class="wrap">
    <h2 class="text-step-3 display">{c.vs.heading}</h2>
    <p class="lede measure mt-5">{c.vs.lede}</p>

    <div class="mt-12 overflow-x-auto">
      <table class="w-full text-left border-collapse min-w-[640px]">
        <thead>
          <tr class="border-b border-rule text-step--1 text-muted">
            <th scope="col" class="py-3 pr-6 font-normal w-[18%]"></th>
            <th scope="col" class="py-3 pr-6 font-normal w-[41%]">{c.vs.thPen}</th>
            <th scope="col" class="py-3 font-normal w-[41%]">{c.vs.thRed}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-rule">
          {c.vs.rows.map(([row, pen, red]) => (
            <tr class="align-top">
              <th scope="row" class="py-4 pr-6 font-semibold">{row}</th>
              <td class="py-4 pr-6 text-muted">{pen}</td>
              <td class="py-4 text-soft">{red}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section border-t border-rule">
  <div class="wrap">
    <h2 class="text-step-3 display">{c.delivers.heading}</h2>
    <ul class="mt-10 divide-y divide-rule border-t border-b border-rule max-w-3xl">
      {c.delivers.items.map((d) => (
        <li class="py-4 grid grid-cols-[1.5rem_1fr] gap-3">
          <span class="text-critical-text machine" aria-hidden="true">&#10003;</span>
          <span>{d}</span>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-step--1 text-muted measure-wide">
      {c.pricing.note} <a href={REDTEAM_ANCHOR} class="link-quiet">{c.pricing.linkLabel}</a>.
    </p>
  </div>
</section>

<section class="section border-t border-rule">
  <div class="wrap">
    <h2 class="text-step-3 display">{c.faq.heading}</h2>
    <div class="mt-10 divide-y divide-rule border-t border-b border-rule max-w-4xl">
      {c.faq.items.map(([q, a]) => (
        <div class="py-5">
          <p class="font-medium">{q}</p>
          <p class="mt-2 text-muted measure-wide">{a}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section border-t border-rule">
  <div class="wrap">
    <div class="sev sev-critical py-1 max-w-4xl">
      <p class="text-step--1 text-muted">{c.cta.kicker}</p>
      <h2 class="mt-2 text-step-4 display max-w-[20ch]">{c.cta.heading}</h2>
      <p class="mt-6 measure-wide">{c.cta.body}</p>
      <a href={bookUrl('red-team')} target="_blank" rel="noopener" class="btn-primary mt-8 text-step-0">{book}</a>
      <p class="machine text-step--1 text-muted mt-5">
        {emailLabel} <a href={`mailto:${EMAIL}?subject=${encodeURIComponent(c.cta.emailSubject)}`} class="hover:text-critical-text transition-colors">{EMAIL}</a>
      </p>
    </div>
  </div>
</section>
